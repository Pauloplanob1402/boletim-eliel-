# ============================================
# SUPABASE
# ============================================
# URL e chave anônima do projeto Supabase (podem ficar expostas no frontend)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de service role — NUNCA exponha no frontend. Usada só nas API routes (servidor).
SUPABASE_SERVICE_ROLE_KEY=

# ============================================
# MERCADO PAGO
# ============================================
# Access Token da aplicação (painel de desenvolvedores do Mercado Pago)
MERCADOPAGO_ACCESS_TOKEN=

# Chave secreta usada para validar a assinatura (header x-signature) do webhook.
# Fica em "Suas integrações" > sua aplicação > Webhooks > Chave secreta.
MERCADOPAGO_WEBHOOK_SECRET=

# IDs dos planos de assinatura no Mercado Pago (criados via /preapproval_plan — ver README passo 6)
MERCADOPAGO_PLAN_ID_MENSAL=
MERCADOPAGO_PLAN_ID_ANUAL=

# ============================================
# SENDER (envio de e-mail)
# ============================================
SENDER_API_KEY=
# ID do grupo/lista de assinantes pagantes na Sender (criado via POST /v2/groups — ver README)
SENDER_GROUP_ID=
SENDER_FROM_EMAIL=
SENDER_FROM_NAME=Sem Mimimi

# ============================================
# CRON
# ============================================
# Segredo compartilhado para autenticar chamadas ao endpoint /api/cron/newsletters
# (a Vercel envia isso automaticamente como Bearer token quando o cron é definido em vercel.json)
CRON_SECRET=

# ============================================
# GERAL
# ============================================
# URL pública do site em produção (usada em back_url do Mercado Pago, links de e-mail, etc.)
APP_URL=https://seudominio.com.br

# Mesma URL acima, mas exposta ao navegador (prefixo NEXT_PUBLIC_) — usada só para montar
# a tag <link rel="canonical"> e as tags Open Graph/Twitter (components/SiteLayout.js) e o
# sitemap.xml (pages/sitemap.xml.js). Troque as duas ao mesmo tempo quando mudar de domínio.
NEXT_PUBLIC_APP_URL=https://seudominio.com.br
